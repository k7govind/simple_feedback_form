<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Page</title>
     <!-- CSS only -->
     <link rel="stylesheet" href="/bootstrap-css/bootstrap.min.css">
    <!-- JavaScript Bundle with Popper -->
    <script src="/bootstrap-js/bootstrap.min.js"></script>
</head>
<body>
    <main>
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h1 class="border-bottom pb-2">
                        Feedback Form
                    </h1>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <% if (formResult  == 'success') { %>
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <strong>Feedback Submitted!! </strong> Thanks for sharing feedback
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                          </div>
                      <% } %>
                      <% if (formResult  == 'fail') { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>Feedback Not Submitted!! </strong> Please try again!!
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                          </div>
                      <% } %>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="mx-auto my-3">
                        <form action="/contact" method="post" id="contactform">
                            <div class="firstname-input my-4">
                                <input type="text" name="firstname" id="firstname" class="form-control border border-primary border-top-0 border-start-0 border-end-0 rounded-0" placeholder="Enter your First name" >
                                <div class="d-none ">Please provide valid first name.</div>
                            </div>
                            <div class="lastname-input my-4">
                                <input type="text" name="lastname" id="lastname" class="form-control border border-primary border-top-0 border-start-0 border-end-0 rounded-0" placeholder="Enter your Last name">
                                <div class="d-none ">Please provide valid last name.</div>
                            </div>
                            <div class="email-input my-4">
                                <input type="email" name="useremail" id="useremail" class="form-control border border-primary border-top-0 border-start-0 border-end-0 rounded-0" placeholder="Enter your email">
                                <div class="d-none ">Please provide valid email.</div>
                            </div>
                            <div class="feedback-input my-4">
                                <textarea name="userfeedback" id="userfeedback" cols="30" rows="10" class="form-control border border-primary border-top-0 border-start-0 border-end-0 rounded-0" placeholder="Enter your Feedback"></textarea>
                            </div>
                            <input type="submit" value="Submit" class="btn btn-outline-success w-100 my-1">
                            <input type="reset" value="Cancel" class="btn btn-outline-danger w-100 my-2">
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <script src="/jquery/jquery.min.js"></script>
    <script src="/jquery-validation/jquery.validate.min.js"></script>
    <script src="/js/fieldValidator.js"></script>
</body>
</html>